# Copy to `.env.local` (gitignored) and fill in. Never commit the real file,
# never pass these as CLI arguments, never paste them into chat or logs.
# scripts/*.py load `.env.local` automatically via trecrag.config.load_dotenv_local.

# ClimbMix access. Request a token by emailing get-pyserini@googlegroups.com.
PYSERINI_API_TOKEN=

# LLM backend for the listwise reranker and the answer generator.
# Ollama exposes an OpenAI-compatible route at /v1 and ignores the API key,
# but trecrag.config.require_env rejects an empty value, so keep the placeholder.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.3:70b-instruct-q4_K_M
LLM_LISTWISE_MODEL=llama3.3:70b-instruct-q4_K_M
